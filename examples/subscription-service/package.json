{
  "name": "enamel-subscription-service-example",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "schema:program": "node tools/extract-program-schema.mjs",
    "schema:database": "node tools/dump-database-schema.mjs",
    "schema:check": "npm run schema:program && npm run schema:database && cue export -e schema ./enamel > /dev/null",
    "schema:check:test": "node tools/check-schema-with-test-database.mjs",
    "test": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "evidence": "npm run check && npm run schema:check:test && npm run test:integration",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "nats": "^2.29.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
